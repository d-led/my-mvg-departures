# syntax=docker/dockerfile:1.4
# Multi-stage build using Google Distroless for maximum security
# Uses setup.sh for consistency with local development
# Stage 1: Build stage
FROM python:3.13-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy everything needed for setup
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY scripts/ ./scripts/

# Set cache directories explicitly for pip and uv
ENV PIP_CACHE_DIR=/root/.cache/pip
ENV UV_CACHE_DIR=/root/.cache/uv

# Run setup script with cache mounts for faster rebuilds
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/uv \
    ./scripts/setup.sh

# Stage 2: Runtime stage - Distroless Python image
FROM gcr.io/distroless/python3-debian12:latest AS runtime

WORKDIR /app

# Copy the entire venv from builder
COPY --from=builder /app/.venv /app/.venv

# Set environment for venv
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# Copy config and static assets with non-root ownership
# Distroless default non-root user is uid 65532
COPY --chown=65532:65532 config.example.toml ./config.example.toml
COPY --chown=65532:65532 static/ ./static/

# Set non-root user
USER 65532:65532

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/')"]

# Run the application
CMD ["/app/.venv/bin/python", "-m", "mvg_departures.main"]
