# syntax=docker/dockerfile:1.4
# Multi-stage build using Red Hat Universal Base Image (UBI)
# UBI provides enterprise-grade security and is freely redistributable
# Uses setup.sh for consistency with local development
# Stage 1: Build stage with UBI
FROM registry.access.redhat.com/ubi9:latest AS builder

WORKDIR /app

# Install EPEL, Python 3.13, and bash for setup script
RUN microdnf install -y --nodocs \
    epel-release \
    && microdnf install -y --nodocs \
    python3.13 \
    python3.13-pip \
    python3.13-devel \
    gcc \
    gcc-c++ \
    bash \
    && microdnf clean all && \
    alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 && \
    alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.13 1 && \
    alternatives --install /usr/bin/python python /usr/bin/python3.13 1

# Install uv for faster dependency management
RUN pip install --no-cache-dir uv

# Copy everything needed for setup
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY scripts/ ./scripts/

# Run setup script with cache mounts for faster rebuilds
RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.cache/uv \
    ./scripts/setup.sh

# Stage 2: Runtime stage - UBI (can't use ubi-minimal as it lacks Python)
FROM registry.access.redhat.com/ubi9:latest AS runtime

WORKDIR /app

# Install Python 3.13 from EPEL
RUN microdnf install -y --nodocs \
    epel-release \
    && microdnf install -y --nodocs \
    python3.13 \
    && microdnf clean all && \
    alternatives --install /usr/bin/python3 python3 /usr/bin/python3.13 1 && \
    alternatives --install /usr/bin/python python /usr/bin/python3.13 1

# Copy the entire venv from builder
COPY --from=builder /app/.venv /app/.venv

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV="/app/.venv"

# Copy config and static assets
COPY config.example.toml ./config.example.toml
COPY static/ ./static/

# UBI images already run as non-root user (default: 1001)
# Ensure proper ownership
RUN chown -R 1001:0 /app && \
    chmod -R g+w /app

# Switch to non-root user (UBI default: uid 1001, gid 0)
USER 1001:0

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/')" || exit 1

# Run the application
CMD ["python", "-m", "mvg_departures.main"]
