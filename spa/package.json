    "@typescript-eslint/parser": "^8.57.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "esbuild": "^0.27.4",
    "eslint": "^10.0.3",
    "eslint-plugin-svelte": "^3.15.2",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
